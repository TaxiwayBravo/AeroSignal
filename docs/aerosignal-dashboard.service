[Unit]
Description=AeroSignal dashboard-only mode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace user, paths and addresses for your Pi before installing.
User=pi
WorkingDirectory=/home/pi/aerosignal
Environment=RECEIVER_URL=http://192.168.1.20:8081
Environment=MAP_URL=http://192.168.1.20:8081/
ExecStart=/usr/bin/python3 /home/pi/aerosignal/app/server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
