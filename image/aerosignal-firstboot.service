[Unit]
Description=AeroSignal wired-or-hotspot first boot
After=NetworkManager.service
Wants=NetworkManager.service
Before=aerosignal-dashboard.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/aerosignal/scripts/appliance_first_boot.py
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
