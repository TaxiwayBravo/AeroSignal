[Unit]
Description=AeroSignal SDR receiver
After=docker.service aerosignal-firstboot.service network-online.target
Wants=docker.service network-online.target
Requires=aerosignal-firstboot.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aerosignal
ExecStart=/usr/bin/docker compose up -d ultrafeeder
RemainAfterExit=yes
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
